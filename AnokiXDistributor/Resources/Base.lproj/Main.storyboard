<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.CocoaTouch.Storyboard.XIB" version="3.0" toolsVersion="22155" targetRuntime="iOS.CocoaTouch" propertyAccessControl="none" useAutolayout="YES" useTraitCollections="YES" useSafeAreas="YES" colorMatched="YES" initialViewController="splash-vc">
    <device id="retina6_12" orientation="portrait" appearance="light"/>
    <dependencies>
        <plugIn identifier="com.apple.InterfaceBuilder.IBCocoaTouchPlugin" version="22131"/>
        <capability name="Safe area layout guides" minToolsVersion="9.0"/>
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/>
        <capability name="System colors in document resources" minToolsVersion="11.0"/>
    </dependencies>
    <scenes>
        <!-- Splash -->
        <scene sceneID="splash-scene">
            <objects>
                <viewController storyboardIdentifier="SplashViewController" id="splash-vc" customClass="SplashViewController" customModule="AnokiXDistributor" customModuleProvider="target" sceneMemberID="viewController">
                    <view key="view" contentMode="scaleToFill" id="splash-view">
                        <rect key="frame" x="0.0" y="0.0" width="393" height="852"/>
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                        <subviews>
                            <view contentMode="scaleToFill" translatesAutoresizingMaskIntoConstraints="NO" id="splash-gradient" customClass="BrandGradientView" customModule="AnokiXDistributor" customModuleProvider="target">
                                <rect key="frame" x="0.0" y="0.0" width="393" height="852"/>
                            </view>
                            <imageView clipsSubviews="YES" userInteractionEnabled="NO" contentMode="scaleAspectFit" horizontalHuggingPriority="251" verticalHuggingPriority="251" image="LogoWhite" translatesAutoresizingMaskIntoConstraints="NO" id="splash-logo">
                                <rect key="frame" x="96.5" y="360" width="200" height="72"/>
                                <constraints>
                                    <constraint firstAttribute="height" relation="lessThanOrEqual" constant="80" id="splash-logo-h"/>
                                </constraints>
                            </imageView>
                            <label opaque="NO" userInteractionEnabled="NO" contentMode="left" horizontalHuggingPriority="251" verticalHuggingPriority="251" text="Distributor App" textAlignment="center" lineBreakMode="tailTruncation" baselineAdjustment="alignBaselines" adjustsFontSizeToFit="NO" translatesAutoresizingMaskIntoConstraints="NO" id="splash-sub">
                                <rect key="frame" x="96.5" y="448" width="200" height="19"/>
                                <fontDescription key="fontDescription" type="system" pointSize="16"/>
                                <color key="textColor" white="1" alpha="1" colorSpace="custom" customColorSpace="genericGamma22GrayColorSpace"/>
                            </label>
                        </subviews>
                        <viewLayoutGuide key="safeArea" id="splash-safe"/>
                        <color key="backgroundColor" red="0.0" green="0.035294117647058823" blue="0.12549019607843137" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
                        <constraints>
                            <constraint firstItem="splash-gradient" firstAttribute="top" secondItem="splash-view" secondAttribute="top" id="sg1"/>
                            <constraint firstItem="splash-gradient" firstAttribute="leading" secondItem="splash-view" secondAttribute="leading" id="sg2"/>
                            <constraint firstItem="splash-gradient" firstAttribute="trailing" secondItem="splash-view" secondAttribute="trailing" id="sg3"/>
                            <constraint firstItem="splash-gradient" firstAttribute="bottom" secondItem="splash-view" secondAttribute="bottom" id="sg4"/>
                            <constraint firstItem="splash-logo" firstAttribute="centerX" secondItem="splash-view" secondAttribute="centerX" id="sl1"/>
                            <constraint firstItem="splash-logo" firstAttribute="centerY" secondItem="splash-view" secondAttribute="centerY" constant="-40" id="sl2"/>
                            <constraint firstItem="splash-logo" firstAttribute="width" secondItem="splash-view" secondAttribute="width" multiplier="0.6" id="sl3"/>
                            <constraint firstItem="splash-sub" firstAttribute="top" secondItem="splash-logo" secondAttribute="bottom" constant="16" id="sl4"/>
                            <constraint firstItem="splash-sub" firstAttribute="centerX" secondItem="splash-view" secondAttribute="centerX" id="sl5"/>
                        </constraints>
                    </view>
                    <connections>
                        <outlet property="logoImageView" destination="splash-logo" id="so1"/>
                        <outlet property="subtitleLabel" destination="splash-sub" id="so2"/>
                    </connections>
                </viewController>
                <placeholder placeholderIdentifier="IBFirstResponder" id="splash-fr" userLabel="First Responder" sceneMemberID="firstResponder"/>
            </objects>
            <point key="canvasLocation" x="-900" y="0"/>
        </scene>
        <!-- Login Navigation -->
        <scene sceneID="login-nav-scene">
            <objects>
                <navigationController storyboardIdentifier="LoginNavigationController" automaticallyAdjustsScrollViewInsets="NO" navigationBarHidden="YES" id="login-nav" sceneMemberID="viewController">
                    <toolbarItems/>
                    <navigationBar key="navigationBar" contentMode="scaleToFill" insetsLayoutMarginsFromSafeArea="NO" id="login-nav-bar">
                        <autoresizingMask key="autoresizingMask"/>
                    </navigationBar>
                    <nil name="viewControllers"/>
                    <connections>
                        <segue destination="login-vc" kind="relationship" relationship="rootViewController" id="login-root-seg"/>
                    </connections>
                </navigationController>
                <placeholder placeholderIdentifier="IBFirstResponder" id="login-nav-fr" userLabel="First Responder" sceneMemberID="firstResponder"/>
            </objects>
            <point key="canvasLocation" x="-400" y="0"/>
        </scene>
        <!-- Login -->
        <scene sceneID="login-scene">
            <objects>
                <viewController storyboardIdentifier="LoginViewController" id="login-vc" customClass="LoginViewController" customModule="AnokiXDistributor" customModuleProvider="target" sceneMemberID="viewController">
                    <view key="view" contentMode="scaleToFill" id="login-view">
                        <rect key="frame" x="0.0" y="0.0" width="393" height="852"/>
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                        <subviews>
                            <view contentMode="scaleToFill" translatesAutoresizingMaskIntoConstraints="NO" id="login-gradient" customClass="BrandGradientView" customModule="AnokiXDistributor" customModuleProvider="target">
                                <rect key="frame" x="0.0" y="0.0" width="393" height="852"/>
                            </view>
                            <imageView clipsSubviews="YES" userInteractionEnabled="NO" contentMode="scaleAspectFit" horizontalHuggingPriority="251" verticalHuggingPriority="251" image="LogoWhite" translatesAutoresizingMaskIntoConstraints="NO" id="login-logo">
                                <rect key="frame" x="78.5" y="200" width="236" height="72"/>
                                <constraints>
                                    <constraint firstAttribute="height" relation="lessThanOrEqual" constant="72" id="ll-h"/>
                                </constraints>
                            </imageView>
                            <label opaque="NO" userInteractionEnabled="NO" contentMode="left" horizontalHuggingPriority="251" verticalHuggingPriority="251" text="Distributor App" textAlignment="center" lineBreakMode="tailTruncation" baselineAdjustment="alignBaselines" adjustsFontSizeToFit="NO" translatesAutoresizingMaskIntoConstraints="NO" id="login-brand-sub">
                                <rect key="frame" x="96.5" y="288" width="200" height="19"/>
                                <fontDescription key="fontDescription" type="system" pointSize="16"/>
                                <color key="textColor" white="1" alpha="1" colorSpace="custom" customColorSpace="genericGamma22GrayColorSpace"/>
                            </label>
                            <view contentMode="scaleToFill" translatesAutoresizingMaskIntoConstraints="NO" id="login-card">
                                <rect key="frame" x="0.0" y="480" width="393" height="372"/>
                                <subviews>
                                    <label opaque="NO" userInteractionEnabled="NO" contentMode="left" horizontalHuggingPriority="251" verticalHuggingPriority="251" text="LOGIN" textAlignment="natural" lineBreakMode="tailTruncation" baselineAdjustment="alignBaselines" adjustsFontSizeToFit="NO" translatesAutoresizingMaskIntoConstraints="NO" id="login-title">
                                        <rect key="frame" x="24" y="28" width="52" height="19"/>
                                        <fontDescription key="fontDescription" type="boldSystem" pointSize="16"/>
                                        <color key="textColor" red="0.058823529411764705" green="0.090196078431372548" blue="0.16470588235294117" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
                                    </label>
                                    <view contentMode="scaleToFill" translatesAutoresizingMaskIntoConstraints="NO" id="login-tab-bg">
                                        <rect key="frame" x="24" y="67" width="345" height="44"/>
                                        <subviews>
                                            <button opaque="NO" contentMode="scaleToFill" contentHorizontalAlignment="center" contentVerticalAlignment="center" lineBreakMode="middleTruncation" translatesAutoresizingMaskIntoConstraints="NO" id="tab-email">
                                                <rect key="frame" x="4" y="4" width="168.5" height="36"/>
                                                <fontDescription key="fontDescription" type="boldSystem" pointSize="14"/>
                                                <state key="normal" title="Email">
                                                    <color key="titleColor" red="0.48627450980392156" green="0.22745098039215686" blue="0.92941176470588238" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
                                                </state>
                                                <connections>
                                                    <action selector="selectEmailTapped:" destination="login-vc" eventType="touchUpInside" id="tab-email-act"/>
                                                </connections>
                                            </button>
                                            <button opaque="NO" contentMode="scaleToFill" contentHorizontalAlignment="center" contentVerticalAlignment="center" lineBreakMode="middleTruncation" translatesAutoresizingMaskIntoConstraints="NO" id="tab-phone">
                                                <rect key="frame" x="172.5" y="4" width="168.5" height="36"/>
                                                <fontDescription key="fontDescription" type="boldSystem" pointSize="14"/>
                                                <state key="normal" title="Phone">
                                                    <color key="titleColor" red="0.39215686274509803" green="0.45490196078431372" blue="0.54509803921568623" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
                                                </state>
                                                <connections>
                                                    <action selector="selectPhoneTapped:" destination="login-vc" eventType="touchUpInside" id="tab-phone-act"/>
                                                </connections>
                                            </button>
                                        </subviews>
                                        <color key="backgroundColor" red="0.94509803921568625" green="0.96078431372549022" blue="0.97647058823529409" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
                                        <constraints>
                                            <constraint firstAttribute="height" constant="44" id="ltb-h"/>
                                            <constraint firstItem="tab-email" firstAttribute="leading" secondItem="login-tab-bg" secondAttribute="leading" constant="4" id="ltb1"/>
                                            <constraint firstItem="tab-email" firstAttribute="top" secondItem="login-tab-bg" secondAttribute="top" constant="4" id="ltb2"/>
                                            <constraint firstItem="tab-email" firstAttribute="bottom" secondItem="login-tab-bg" secondAttribute="bottom" constant="-4" id="ltb3"/>
                                            <constraint firstItem="tab-phone" firstAttribute="leading" secondItem="tab-email" secondAttribute="trailing" id="ltb4"/>
                                            <constraint firstItem="tab-phone" firstAttribute="top" secondItem="tab-email" secondAttribute="top" id="ltb5"/>
                                            <constraint firstItem="tab-phone" firstAttribute="bottom" secondItem="tab-email" secondAttribute="bottom" id="ltb6"/>
                                            <constraint firstItem="tab-phone" firstAttribute="trailing" secondItem="login-tab-bg" secondAttribute="trailing" constant="-4" id="ltb7"/>
                                            <constraint firstItem="tab-email" firstAttribute="width" secondItem="tab-phone" secondAttribute="width" id="ltb8"/>
                                        </constraints>
                                    </view>
                                    <label opaque="NO" userInteractionEnabled="NO" contentMode="left" horizontalHuggingPriority="251" verticalHuggingPriority="251" text="Email address" textAlignment="natural" lineBreakMode="tailTruncation" baselineAdjustment="alignBaselines" adjustsFontSizeToFit="NO" translatesAutoresizingMaskIntoConstraints="NO" id="lbl-email">
                                        <rect key="frame" x="24" y="131" width="90" height="16"/>
                                        <fontDescription key="fontDescription" type="system" pointSize="13"/>
                                    </label>
                                    <textField opaque="NO" contentMode="scaleToFill" horizontalHuggingPriority="248" contentHorizontalAlignment="left" contentVerticalAlignment="center" placeholder="cong@anokix.co.za" textAlignment="natural" minimumFontSize="17" translatesAutoresizingMaskIntoConstraints="NO" id="field-email">
                                        <rect key="frame" x="24" y="152" width="345" height="48"/>
                                        <constraints>
                                            <constraint firstAttribute="height" constant="48" id="fe-h"/>
                                        </constraints>
                                        <fontDescription key="fontDescription" type="system" pointSize="14"/>
                                        <textInputTraits key="textInputTraits" keyboardType="emailAddress" autocapitalizationType="none" autocorrectionType="no"/>
                                    </textField>
                                    <label opaque="NO" userInteractionEnabled="NO" contentMode="left" horizontalHuggingPriority="251" verticalHuggingPriority="251" text="Password" textAlignment="natural" lineBreakMode="tailTruncation" baselineAdjustment="alignBaselines" adjustsFontSizeToFit="NO" translatesAutoresizingMaskIntoConstraints="NO" id="lbl-pass">
                                        <rect key="frame" x="24" y="216" width="62" height="16"/>
                                        <fontDescription key="fontDescription" type="system" pointSize="13"/>
                                    </label>
                                    <textField opaque="NO" contentMode="scaleToFill" horizontalHuggingPriority="248" contentHorizontalAlignment="left" contentVerticalAlignment="center" placeholder="••••••••" textAlignment="natural" minimumFontSize="17" translatesAutoresizingMaskIntoConstraints="NO" id="field-pass">
                                        <rect key="frame" x="24" y="237" width="345" height="48"/>
                                        <constraints>
                                            <constraint firstAttribute="height" constant="48" id="fp-h"/>
                                        </constraints>
                                        <fontDescription key="fontDescription" type="system" pointSize="14"/>
                                        <textInputTraits key="textInputTraits" secureTextEntry="YES"/>
                                    </textField>
                                    <button opaque="NO" contentMode="scaleToFill" contentHorizontalAlignment="trailing" contentVerticalAlignment="center" lineBreakMode="middleTruncation" translatesAutoresizingMaskIntoConstraints="NO" id="btn-forgot">
                                        <rect key="frame" x="24" y="295" width="345" height="30"/>
                                        <state key="normal" title="Forgot password?">
                                            <color key="titleColor" red="0.48627450980392156" green="0.22745098039215686" blue="0.92941176470588238" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
                                        </state>
                                        <connections>
                                            <action selector="forgotTapped:" destination="login-vc" eventType="touchUpInside" id="bf-act"/>
                                        </connections>
                                    </button>
                                    <button opaque="NO" contentMode="scaleToFill" contentHorizontalAlignment="center" contentVerticalAlignment="center" lineBreakMode="middleTruncation" translatesAutoresizingMaskIntoConstraints="NO" id="btn-login">
                                        <rect key="frame" x="24" y="325" width="345" height="48"/>
                                        <color key="backgroundColor" red="0.48627450980392156" green="0.22745098039215686" blue="0.92941176470588238" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
                                        <constraints>
                                            <constraint firstAttribute="height" constant="48" id="bl-h"/>
                                        </constraints>
                                        <fontDescription key="fontDescription" type="boldSystem" pointSize="15"/>
                                        <state key="normal" title="Login">
                                            <color key="titleColor" white="1" alpha="1" colorSpace="custom" customColorSpace="genericGamma22GrayColorSpace"/>
                                        </state>
                                        <userDefinedRuntimeAttributes>
                                            <userDefinedRuntimeAttribute type="number" keyPath="layer.cornerRadius">
                                                <real key="value" value="10"/>
                                            </userDefinedRuntimeAttribute>
                                        </userDefinedRuntimeAttributes>
                                        <connections>
                                            <action selector="loginTapped:" destination="login-vc" eventType="touchUpInside" id="bl-act"/>
                                        </connections>
                                    </button>
                                    <button opaque="NO" contentMode="scaleToFill" contentHorizontalAlignment="center" contentVerticalAlignment="center" lineBreakMode="middleTruncation" translatesAutoresizingMaskIntoConstraints="NO" id="btn-join">
                                        <rect key="frame" x="24" y="385" width="345" height="48"/>
                                        <constraints>
                                            <constraint firstAttribute="height" constant="48" id="bj-h"/>
                                        </constraints>
                                        <fontDescription key="fontDescription" type="system" pointSize="14"/>
                                        <state key="normal" title="Join Distributor App now">
                                            <color key="titleColor" red="0.48627450980392156" green="0.22745098039215686" blue="0.92941176470588238" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
                                        </state>
                                        <userDefinedRuntimeAttributes>
                                            <userDefinedRuntimeAttribute type="number" keyPath="layer.cornerRadius">
                                                <real key="value" value="10"/>
                                            </userDefinedRuntimeAttribute>
                                            <userDefinedRuntimeAttribute type="number" keyPath="layer.borderWidth">
                                                <real key="value" value="1"/>
                                            </userDefinedRuntimeAttribute>
                                            <userDefinedRuntimeAttribute type="color" keyPath="layer.borderColor">
                                                <color key="value" red="0.48627450980392156" green="0.22745098039215686" blue="0.92941176470588238" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
                                            </userDefinedRuntimeAttribute>
                                        </userDefinedRuntimeAttributes>
                                        <connections>
                                            <action selector="joinTapped:" destination="login-vc" eventType="touchUpInside" id="bj-act"/>
                                        </connections>
                                    </button>
                                    <button opaque="NO" contentMode="scaleToFill" contentHorizontalAlignment="center" contentVerticalAlignment="center" lineBreakMode="middleTruncation" translatesAutoresizingMaskIntoConstraints="NO" id="btn-toggle-pass">
                                        <rect key="frame" x="333" y="249" width="24" height="24"/>
                                        <state key="normal" image="eye" catalog="system"/>
                                        <connections>
                                            <action selector="togglePasswordTapped:" destination="login-vc" eventType="touchUpInside" id="btp-act"/>
                                        </connections>
                                    </button>
                                </subviews>
                                <color key="backgroundColor" white="1" alpha="1" colorSpace="custom" customColorSpace="genericGamma22GrayColorSpace"/>
                                <constraints>
                                    <constraint firstItem="login-title" firstAttribute="top" secondItem="login-card" secondAttribute="top" constant="28" id="lc1"/>
                                    <constraint firstItem="login-title" firstAttribute="leading" secondItem="login-card" secondAttribute="leading" constant="24" id="lc2"/>
                                    <constraint firstItem="login-tab-bg" firstAttribute="top" secondItem="login-title" secondAttribute="bottom" constant="20" id="lc3"/>
                                    <constraint firstItem="login-tab-bg" firstAttribute="leading" secondItem="login-card" secondAttribute="leading" constant="24" id="lc4"/>
                                    <constraint firstItem="login-tab-bg" firstAttribute="trailing" secondItem="login-card" secondAttribute="trailing" constant="-24" id="lc5"/>
                                    <constraint firstItem="lbl-email" firstAttribute="top" secondItem="login-tab-bg" secondAttribute="bottom" constant="20" id="lc6"/>
                                    <constraint firstItem="lbl-email" firstAttribute="leading" secondItem="login-card" secondAttribute="leading" constant="24" id="lc7"/>
                                    <constraint firstItem="field-email" firstAttribute="top" secondItem="lbl-email" secondAttribute="bottom" constant="5" id="lc8"/>
                                    <constraint firstItem="field-email" firstAttribute="leading" secondItem="login-card" secondAttribute="leading" constant="24" id="lc9"/>
                                    <constraint firstItem="field-email" firstAttribute="trailing" secondItem="login-card" secondAttribute="trailing" constant="-24" id="lc10"/>
                                    <constraint firstItem="lbl-pass" firstAttribute="top" secondItem="field-email" secondAttribute="bottom" constant="16" id="lc11"/>
                                    <constraint firstItem="lbl-pass" firstAttribute="leading" secondItem="login-card" secondAttribute="leading" constant="24" id="lc12"/>
                                    <constraint firstItem="field-pass" firstAttribute="top" secondItem="lbl-pass" secondAttribute="bottom" constant="5" id="lc13"/>
                                    <constraint firstItem="field-pass" firstAttribute="leading" secondItem="login-card" secondAttribute="leading" constant="24" id="lc14"/>
                                    <constraint firstItem="field-pass" firstAttribute="trailing" secondItem="login-card" secondAttribute="trailing" constant="-24" id="lc15"/>
                                    <constraint firstItem="btn-toggle-pass" firstAttribute="trailing" secondItem="field-pass" secondAttribute="trailing" constant="-12" id="lc16"/>
                                    <constraint firstItem="btn-toggle-pass" firstAttribute="centerY" secondItem="field-pass" secondAttribute="centerY" id="lc17"/>
                                    <constraint firstItem="btn-forgot" firstAttribute="top" secondItem="field-pass" secondAttribute="bottom" constant="10" id="lc18"/>
                                    <constraint firstItem="btn-forgot" firstAttribute="leading" secondItem="login-card" secondAttribute="leading" constant="24" id="lc19"/>
                                    <constraint firstItem="btn-forgot" firstAttribute="trailing" secondItem="login-card" secondAttribute="trailing" constant="-24" id="lc20"/>
                                    <constraint firstItem="btn-login" firstAttribute="top" secondItem="btn-forgot" secondAttribute="bottom" constant="20" id="lc21"/>
                                    <constraint firstItem="btn-login" firstAttribute="leading" secondItem="login-card" secondAttribute="leading" constant="24" id="lc22"/>
                                    <constraint firstItem="btn-login" firstAttribute="trailing" secondItem="login-card" secondAttribute="trailing" constant="-24" id="lc23"/>
                                    <constraint firstItem="btn-join" firstAttribute="top" secondItem="btn-login" secondAttribute="bottom" constant="12" id="lc24"/>
                                    <constraint firstItem="btn-join" firstAttribute="leading" secondItem="login-card" secondAttribute="leading" constant="24" id="lc25"/>
                                    <constraint firstItem="btn-join" firstAttribute="trailing" secondItem="login-card" secondAttribute="trailing" constant="-24" id="lc26"/>
                                    <constraint firstItem="btn-join" firstAttribute="bottom" secondItem="login-card" secondAttribute="bottom" constant="-32" id="lc27"/>
                                </constraints>
                                <userDefinedRuntimeAttributes>
                                    <userDefinedRuntimeAttribute type="number" keyPath="layer.cornerRadius">
                                        <real key="value" value="24"/>
                                    </userDefinedRuntimeAttribute>
                                    <userDefinedRuntimeAttribute type="number" keyPath="layer.maskedCorners">
                                        <integer key="value" value="3"/>
                                    </userDefinedRuntimeAttribute>
                                </userDefinedRuntimeAttributes>
                            </view>
                        </subviews>
                        <viewLayoutGuide key="safeArea" id="login-safe"/>
                        <color key="backgroundColor" red="0.0" green="0.035294117647058823" blue="0.12549019607843137" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
                        <constraints>
                            <constraint firstItem="login-gradient" firstAttribute="top" secondItem="login-view" secondAttribute="top" id="lg1"/>
                            <constraint firstItem="login-gradient" firstAttribute="leading" secondItem="login-view" secondAttribute="leading" id="lg2"/>
                            <constraint firstItem="login-gradient" firstAttribute="trailing" secondItem="login-view" secondAttribute="trailing" id="lg3"/>
                            <constraint firstItem="login-gradient" firstAttribute="bottom" secondItem="login-view" secondAttribute="bottom" id="lg4"/>
                            <constraint firstItem="login-logo" firstAttribute="centerX" secondItem="login-view" secondAttribute="centerX" id="ll1"/>
                            <constraint firstItem="login-logo" firstAttribute="width" secondItem="login-view" secondAttribute="width" multiplier="0.6" id="ll2"/>
                            <constraint firstItem="login-brand-sub" firstAttribute="top" secondItem="login-logo" secondAttribute="bottom" constant="16" id="ll3"/>
                            <constraint firstItem="login-brand-sub" firstAttribute="centerX" secondItem="login-view" secondAttribute="centerX" id="ll4"/>
                            <constraint firstItem="login-card" firstAttribute="leading" secondItem="login-view" secondAttribute="leading" id="lcard1"/>
                            <constraint firstItem="login-card" firstAttribute="trailing" secondItem="login-view" secondAttribute="trailing" id="lcard2"/>
                            <constraint firstItem="login-card" firstAttribute="bottom" secondItem="login-view" secondAttribute="bottom" id="lcard3"/>
                            <constraint firstItem="login-card" firstAttribute="top" secondItem="login-brand-sub" secondAttribute="bottom" constant="24" id="lcard4"/>
                        </constraints>
                    </view>
                    <connections>
                        <outlet property="emailField" destination="field-email" id="lo1"/>
                        <outlet property="loginButton" destination="btn-login" id="lo2"/>
                        <outlet property="passwordField" destination="field-pass" id="lo3"/>
                        <outlet property="tabEmailButton" destination="tab-email" id="lo4"/>
                        <outlet property="tabPhoneButton" destination="tab-phone" id="lo5"/>
                        <outlet property="togglePasswordButton" destination="btn-toggle-pass" id="lo6"/>
                    </connections>
                </viewController>
