                                    </view>
                                    <view contentMode="scaleToFill" translatesAutoresizingMaskIntoConstraints="NO" id="prod-title-panel">
                                        <subviews>
                                            <label opaque="NO" userInteractionEnabled="NO" contentMode="left" text="Products" translatesAutoresizingMaskIntoConstraints="NO" id="prod-title-lbl">
                                                <fontDescription key="fontDescription" type="boldSystem" pointSize="16"/>
                                            </label>
                                        </subviews>
                                        <color key="backgroundColor" white="1" alpha="1" colorSpace="custom" customColorSpace="genericGamma22GrayColorSpace"/>
                                        <constraints>
                                            <constraint firstItem="prod-title-lbl" firstAttribute="top" secondItem="prod-title-panel" secondAttribute="top" constant="16" id="pt1"/>
                                            <constraint firstItem="prod-title-lbl" firstAttribute="leading" secondItem="prod-title-panel" secondAttribute="leading" constant="16" id="pt2"/>
                                            <constraint firstItem="prod-title-lbl" firstAttribute="bottom" secondItem="prod-title-panel" secondAttribute="bottom" constant="-12" id="pt3"/>
                                        </constraints>
                                    </view>
                                </subviews>
                            </stackView>
                            <view contentMode="scaleToFill" translatesAutoresizingMaskIntoConstraints="NO" id="prod-content">
                                <subviews>
                                    <textField opaque="NO" contentMode="scaleToFill" placeholder="Search products…" translatesAutoresizingMaskIntoConstraints="NO" id="prod-search">
                                        <constraints><constraint firstAttribute="height" constant="42" id="ps-h"/></constraints>
                                        <fontDescription key="fontDescription" type="system" pointSize="13"/>
                                        <textInputTraits key="textInputTraits"/>
                                    </textField>
                                    <collectionView clipsSubviews="YES" multipleTouchEnabled="YES" contentMode="scaleToFill" alwaysBounceVertical="YES" dataMode="none" translatesAutoresizingMaskIntoConstraints="NO" id="prod-table">
                                        <color key="backgroundColor" red="0.945" green="0.961" blue="0.976" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
                                        <collectionViewFlowLayout key="collectionViewLayout" minimumLineSpacing="8" minimumInteritemSpacing="16" id="prod-cvlayout">
                                            <size key="itemSize" width="160" height="96"/>
                                            <size key="headerReferenceSize" width="0.0" height="0.0"/>
                                            <size key="footerReferenceSize" width="0.0" height="0.0"/>
                                            <inset key="sectionInset" minX="16" minY="0.0" maxX="16" maxY="8"/>
                                        </collectionViewFlowLayout>
                                    </collectionView>
                                    <button opaque="NO" contentMode="scaleToFill" contentHorizontalAlignment="center" contentVerticalAlignment="center" lineBreakMode="middleTruncation" translatesAutoresizingMaskIntoConstraints="NO" id="prod-fab">
                                        <state key="normal" title=" Add Product" image="plus" catalog="system"/>
                                        <connections>
                                            <action selector="addProductTapped:" destination="prod-vc" eventType="touchUpInside" id="prod-fab-act"/>
                                        </connections>
                                    </button>
                                </subviews>
                                <color key="backgroundColor" red="0.945" green="0.961" blue="0.976" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
                                <constraints>
                                    <constraint firstItem="prod-search" firstAttribute="top" secondItem="prod-content" secondAttribute="top" constant="12" id="pc1"/>
                                    <constraint firstItem="prod-search" firstAttribute="leading" secondItem="prod-content" secondAttribute="leading" constant="16" id="pc2"/>
                                    <constraint firstItem="prod-search" firstAttribute="trailing" secondItem="prod-content" secondAttribute="trailing" constant="-16" id="pc3"/>
                                    <constraint firstItem="prod-table" firstAttribute="top" secondItem="prod-search" secondAttribute="bottom" constant="12" id="pc4"/>
                                    <constraint firstItem="prod-table" firstAttribute="leading" secondItem="prod-content" secondAttribute="leading" id="pc5"/>
                                    <constraint firstItem="prod-table" firstAttribute="trailing" secondItem="prod-content" secondAttribute="trailing" id="pc6"/>
                                    <constraint firstItem="prod-table" firstAttribute="bottom" secondItem="prod-content" secondAttribute="bottom" id="pc7"/>
                                    <constraint firstItem="prod-fab" firstAttribute="trailing" secondItem="prod-content" secondAttribute="trailing" constant="-16" id="pc8"/>
                                    <constraint firstItem="prod-fab" firstAttribute="bottom" secondItem="prod-content" secondAttribute="bottom" constant="-16" id="pc9"/>
                                    <constraint firstItem="prod-fab" firstAttribute="height" constant="48" id="pc10"/>
                                </constraints>
                            </view>
                        </subviews>
                        <viewLayoutGuide key="safeArea" id="prod-safe"/>
                        <color key="backgroundColor" red="0.945" green="0.961" blue="0.976" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
                        <constraints>
                            <constraint firstItem="prod-chrome" firstAttribute="top" secondItem="prod-safe" secondAttribute="top" id="pv1"/>
                            <constraint firstItem="prod-chrome" firstAttribute="leading" secondItem="prod-view" secondAttribute="leading" id="pv2"/>
                            <constraint firstItem="prod-chrome" firstAttribute="trailing" secondItem="prod-view" secondAttribute="trailing" id="pv3"/>
                            <constraint firstItem="prod-content" firstAttribute="top" secondItem="prod-chrome" secondAttribute="bottom" id="pv4"/>
                            <constraint firstItem="prod-content" firstAttribute="leading" secondItem="prod-view" secondAttribute="leading" id="pv5"/>
                            <constraint firstItem="prod-content" firstAttribute="trailing" secondItem="prod-view" secondAttribute="trailing" id="pv6"/>
                            <constraint firstItem="prod-content" firstAttribute="bottom" secondItem="prod-safe" secondAttribute="bottom" id="pv7"/>
                        </constraints>
                    </view>
                    <connections>
                        <outlet property="addProductButton" destination="prod-fab" id="po-fab"/>
                        <outlet property="chromeStackView" destination="prod-chrome" id="po1"/>
                        <outlet property="contentView" destination="prod-content" id="po2"/>
                        <outlet property="logoImageView" destination="prod-logo-img" id="po-logo"/>
                        <outlet property="logoSubtitleLabel" destination="prod-logo-sub" id="po-sub"/>
                        <outlet property="pageTitleLabel" destination="prod-title-lbl" id="po-title"/>
                        <outlet property="productsCollectionView" destination="prod-table" id="po-table"/>
                        <outlet property="searchField" destination="prod-search" id="po-search"/>
                    </connections>
                </viewController>
                <placeholder placeholderIdentifier="IBFirstResponder" id="prod-fr" userLabel="First Responder" sceneMemberID="firstResponder"/>
            </objects>
            <point key="canvasLocation" x="1900" y="-800"/>
        </scene>
    </scenes>
    <resources>
        <image name="LogoBlack" width="128" height="128"/>
        <image name="LogoWhite" width="128" height="128"/>
        <image name="bag.fill" catalog="system" width="128" height="114"/>
        <image name="bell" catalog="system" width="128" height="123"/>
        <image name="doc.text.fill" catalog="system" width="128" height="121"/>
        <image name="eye" catalog="system" width="128" height="87"/>
        <image name="line.3.horizontal" catalog="system" width="128" height="93"/>
        <image name="plus" catalog="system" width="128" height="113"/>
        <image name="shippingbox.fill" catalog="system" width="128" height="112"/>
        <image name="square.grid.2x2.fill" catalog="system" width="128" height="113"/>
    </resources>
</document>
