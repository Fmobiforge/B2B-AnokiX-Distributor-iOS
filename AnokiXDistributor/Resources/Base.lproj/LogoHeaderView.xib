<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.CocoaTouch.XIB" version="3.0" toolsVersion="22155" targetRuntime="iOS.CocoaTouch" propertyAccessControl="none" useAutolayout="YES" useTraitCollections="YES" useSafeAreas="YES" colorMatched="YES">
    <device id="retina6_12" orientation="portrait" appearance="light"/>
    <dependencies>
        <plugIn identifier="com.apple.InterfaceBuilder.IBCocoaTouchPlugin" version="22131"/>
        <capability name="Safe area layout guides" minToolsVersion="9.0"/>
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/>
    </dependencies>
    <objects>
        <placeholder placeholderIdentifier="IBFilesOwner" id="-1" userLabel="File's Owner"/>
        <placeholder placeholderIdentifier="IBFirstResponder" id="-2" customClass="UIResponder"/>
        <view contentMode="scaleToFill" id="lh-root" customClass="LogoHeaderView" customModule="AnokiXDistributor" customModuleProvider="target">
            <rect key="frame" x="0.0" y="0.0" width="393" height="72"/>
            <autoresizingMask key="autoresizingMask" widthSizable="YES" flexibleMaxY="YES"/>
            <subviews>
                <imageView clipsSubviews="YES" userInteractionEnabled="NO" contentMode="scaleAspectFit" horizontalHuggingPriority="251" verticalHuggingPriority="251" image="LogoBlack" translatesAutoresizingMaskIntoConstraints="NO" id="lh-logo">
                    <rect key="frame" x="16" y="59" width="80" height="28"/>
                    <constraints>
                        <constraint firstAttribute="height" relation="lessThanOrEqual" constant="28" id="lh-logo-h"/>
                    </constraints>
                </imageView>
                <label opaque="NO" userInteractionEnabled="NO" contentMode="left" horizontalHuggingPriority="251" verticalHuggingPriority="251" text="Distributor App" textAlignment="natural" lineBreakMode="tailTruncation" baselineAdjustment="alignBaselines" adjustsFontSizeToFit="NO" translatesAutoresizingMaskIntoConstraints="NO" id="lh-sub">
                    <rect key="frame" x="16" y="91" width="80" height="12"/>
                    <fontDescription key="fontDescription" type="system" weight="light" pointSize="10"/>
                    <color key="textColor" red="0.39215686274509803" green="0.45490196078431372" blue="0.54509803921568623" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
                </label>
                <button opaque="NO" contentMode="scaleToFill" contentHorizontalAlignment="center" contentVerticalAlignment="center" lineBreakMode="middleTruncation" translatesAutoresizingMaskIntoConstraints="NO" id="lh-bell">
                    <rect key="frame" x="341" y="59" width="36" height="36"/>
                    <constraints>
                        <constraint firstAttribute="width" constant="36" id="lh-bell-w"/>
                        <constraint firstAttribute="height" constant="36" id="lh-bell-h"/>
                    </constraints>
                    <state key="normal" image="bell" catalog="system"/>
                    <connections>
                        <action selector="notificationsTapped:" destination="lh-root" eventType="touchUpInside" id="lh-bell-act"/>
                    </connections>
                </button>
                <view contentMode="scaleToFill" translatesAutoresizingMaskIntoConstraints="NO" id="lh-div">
                    <rect key="frame" x="0.0" y="71" width="393" height="1"/>
                    <color key="backgroundColor" red="0.8862745098039215" green="0.90980392156862744" blue="0.94117647058823528" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
                    <constraints>
                        <constraint firstAttribute="height" constant="1" id="lh-div-h"/>
                    </constraints>
                </view>
            </subviews>
            <viewLayoutGuide key="safeArea" id="lh-safe"/>
            <color key="backgroundColor" white="1" alpha="1" colorSpace="custom" customColorSpace="genericGamma22GrayColorSpace"/>
            <constraints>
                <constraint firstItem="lh-logo" firstAttribute="leading" secondItem="lh-root" secondAttribute="leading" constant="16" id="c1"/>
                <constraint firstItem="lh-logo" firstAttribute="top" secondItem="lh-safe" secondAttribute="top" constant="12" id="c2"/>
                <constraint firstItem="lh-sub" firstAttribute="leading" secondItem="lh-logo" secondAttribute="leading" id="c3"/>
                <constraint firstItem="lh-sub" firstAttribute="top" secondItem="lh-logo" secondAttribute="bottom" constant="4" id="c4"/>
                <constraint firstItem="lh-bell" firstAttribute="trailing" secondItem="lh-root" secondAttribute="trailing" constant="-16" id="c5"/>
                <constraint firstItem="lh-bell" firstAttribute="centerY" secondItem="lh-logo" secondAttribute="centerY" id="c6"/>
                <constraint firstItem="lh-div" firstAttribute="leading" secondItem="lh-root" secondAttribute="leading" id="c7"/>
                <constraint firstItem="lh-div" firstAttribute="trailing" secondItem="lh-root" secondAttribute="trailing" id="c8"/>
                <constraint firstItem="lh-div" firstAttribute="bottom" secondItem="lh-root" secondAttribute="bottom" id="c9"/>
                <constraint firstItem="lh-div" firstAttribute="top" relation="greaterThanOrEqual" secondItem="lh-sub" secondAttribute="bottom" constant="8" id="c10"/>
            </constraints>
            <connections>
                <outlet property="logoImageView" destination="lh-logo" id="o1"/>
                <outlet property="notificationsButton" destination="lh-bell" id="o2"/>
                <outlet property="subtitleLabel" destination="lh-sub" id="o3"/>
            </connections>
        </view>
    </objects>
    <resources>
        <image name="LogoBlack" width="128" height="128"/>
        <image name="bell" catalog="system" width="128" height="123"/>
    </resources>
</document>
