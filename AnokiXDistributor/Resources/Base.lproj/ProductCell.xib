                            <constraint firstItem="row" firstAttribute="top" secondItem="card" secondAttribute="top" constant="12" id="r-t"/>
                            <constraint firstAttribute="trailing" secondItem="row" secondAttribute="trailing" constant="12" id="r-tr"/>
                            <constraint firstAttribute="bottom" secondItem="row" secondAttribute="bottom" constant="12" id="r-b"/>
