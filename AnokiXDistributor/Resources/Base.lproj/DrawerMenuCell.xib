<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.CocoaTouch.XIB" version="3.0" toolsVersion="22155" targetRuntime="iOS.CocoaTouch" propertyAccessControl="none" useAutolayout="YES" useTraitCollections="YES" useSafeAreas="YES" colorMatched="YES">
    <device id="retina6_12" orientation="portrait" appearance="light"/>
    <dependencies>
        <plugIn identifier="com.apple.InterfaceBuilder.IBCocoaTouchPlugin" version="22131"/>
        <capability name="Safe area layout guides" minToolsVersion="9.0"/>
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/>
    </dependencies>
    <objects>
        <placeholder placeholderIdentifier="IBFilesOwner" id="-1" userLabel="File's Owner"/>
        <placeholder placeholderIdentifier="IBFirstResponder" id="-2" customClass="UIResponder"/>
        <tableViewCell contentMode="scaleToFill" selectionStyle="none" indentationWidth="10" reuseIdentifier="DrawerMenuCell" id="root" customClass="DrawerMenuCell" customModule="AnokiXDistributor" customModuleProvider="target">
            <rect key="frame" x="0.0" y="0.0" width="280" height="44"/>
            <autoresizingMask key="autoresizingMask" flexibleMaxX="YES" flexibleMaxY="YES"/>
            <tableViewCellContentView key="contentView" opaque="NO" clipsSubviews="YES" multipleTouchEnabled="YES" contentMode="center" tableViewCell="root" id="cv">
                <rect key="frame" x="0.0" y="0.0" width="280" height="44"/>
                <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                <subviews>
                    <view contentMode="scaleToFill" translatesAutoresizingMaskIntoConstraints="NO" id="pill">
                        <rect key="frame" x="12" y="2" width="256" height="40"/>
                    </view>
                    <imageView clipsSubviews="YES" userInteractionEnabled="NO" contentMode="scaleAspectFit" horizontalHuggingPriority="251" verticalHuggingPriority="251" translatesAutoresizingMaskIntoConstraints="NO" id="icon">
                        <rect key="frame" x="28" y="11" width="22" height="22"/>
                        <constraints>
                            <constraint firstAttribute="width" constant="22" id="ic-w"/>
                            <constraint firstAttribute="height" constant="22" id="ic-h"/>
                        </constraints>
                    </imageView>
                    <label opaque="NO" userInteractionEnabled="NO" contentMode="left" horizontalHuggingPriority="251" verticalHuggingPriority="251" text="Menu item" textAlignment="natural" lineBreakMode="tailTruncation" baselineAdjustment="alignBaselines" adjustsFontSizeToFit="NO" translatesAutoresizingMaskIntoConstraints="NO" id="title">
                        <rect key="frame" x="66" y="12" width="180" height="20"/>
                    </label>
                </subviews>
                <constraints>
                    <constraint firstItem="pill" firstAttribute="leading" secondItem="cv" secondAttribute="leading" constant="12" id="p-l"/>
                    <constraint firstAttribute="trailing" secondItem="pill" secondAttribute="trailing" constant="12" id="p-tr"/>
                    <constraint firstItem="pill" firstAttribute="top" secondItem="cv" secondAttribute="top" constant="2" id="p-t"/>
                    <constraint firstAttribute="bottom" secondItem="pill" secondAttribute="bottom" constant="2" id="p-b"/>
                    <constraint firstItem="icon" firstAttribute="leading" secondItem="pill" secondAttribute="leading" constant="16" id="i-l"/>
                    <constraint firstItem="icon" firstAttribute="centerY" secondItem="cv" secondAttribute="centerY" id="i-cy"/>
                    <constraint firstItem="title" firstAttribute="leading" secondItem="icon" secondAttribute="trailing" constant="16" id="t-l"/>
                    <constraint firstItem="title" firstAttribute="centerY" secondItem="cv" secondAttribute="centerY" id="t-cy"/>
                    <constraint firstItem="pill" firstAttribute="trailing" relation="greaterThanOrEqual" secondItem="title" secondAttribute="trailing" constant="16" id="t-tr"/>
                </constraints>
            </tableViewCellContentView>
            <connections>
                <outlet property="iconImageView" destination="icon" id="o-icon"/>
                <outlet property="pillView" destination="pill" id="o-pill"/>
                <outlet property="titleLabel" destination="title" id="o-title"/>
            </connections>
            <point key="canvasLocation" x="132" y="124"/>
        </tableViewCell>
    </objects>
</document>
