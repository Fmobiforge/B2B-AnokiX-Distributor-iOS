            </objects>
            <point key="canvasLocation" x="100" y="0"/>
        </scene>
        <!-- Main Tab Bar -->
        <scene sceneID="tab-scene">
            <objects>
                <tabBarController storyboardIdentifier="MainTabBarController" id="main-tab" customClass="MainTabBarController" customModule="AnokiXDistributor" customModuleProvider="target" sceneMemberID="viewController">
                    <tabBar key="tabBar" contentMode="scaleToFill" insetsLayoutMarginsFromSafeArea="YES" id="main-tab-bar">
                        <rect key="frame" x="0.0" y="0.0" width="393" height="49"/>
                        <autoresizingMask key="autoresizingMask"/>
                        <color key="backgroundColor" white="1" alpha="1" colorSpace="custom" customColorSpace="genericGamma22GrayColorSpace"/>
                    </tabBar>
                    <connections>
                        <segue destination="dash-nav" kind="relationship" relationship="viewControllers" id="tab-seg-home"/>
                        <segue destination="orders-nav" kind="relationship" relationship="viewControllers" id="tab-seg-orders"/>
                        <segue destination="inv-nav" kind="relationship" relationship="viewControllers" id="tab-seg-inv"/>
                        <segue destination="prod-nav" kind="relationship" relationship="viewControllers" id="tab-seg-prod"/>
                    </connections>
                </tabBarController>
                <placeholder placeholderIdentifier="IBFirstResponder" id="tab-fr" userLabel="First Responder" sceneMemberID="firstResponder"/>
            </objects>
            <point key="canvasLocation" x="700" y="0"/>
        </scene>
        <!-- Dashboard Nav -->
        <scene sceneID="dash-nav-scene">
            <objects>
                <navigationController storyboardIdentifier="DashboardNavigationController" automaticallyAdjustsScrollViewInsets="NO" navigationBarHidden="YES" id="dash-nav" sceneMemberID="viewController">
                    <tabBarItem key="tabBarItem" title="Home" image="square.grid.2x2.fill" catalog="system" id="dash-tab-item"/>
                    <toolbarItems/>
                    <navigationBar key="navigationBar" contentMode="scaleToFill" insetsLayoutMarginsFromSafeArea="NO" id="dash-nav-bar">
                        <autoresizingMask key="autoresizingMask"/>
                    </navigationBar>
                    <nil name="viewControllers"/>
                    <connections>
                        <segue destination="dash-vc" kind="relationship" relationship="rootViewController" id="dash-root"/>
                    </connections>
                </navigationController>
                <placeholder placeholderIdentifier="IBFirstResponder" id="dash-nav-fr" userLabel="First Responder" sceneMemberID="firstResponder"/>
            </objects>
            <point key="canvasLocation" x="700" y="-400"/>
        </scene>
        <!-- Dashboard -->
        <scene sceneID="dash-scene">
            <objects>
                <viewController id="dash-vc" customClass="DashboardViewController" customModule="AnokiXDistributor" customModuleProvider="target" sceneMemberID="viewController">
                    <view key="view" contentMode="scaleToFill" id="dash-view">
                        <rect key="frame" x="0.0" y="0.0" width="393" height="852"/>
                        <autoresizingMask key="autoresizingMask" widthSizable="YES" heightSizable="YES"/>
                        <subviews>
                            <stackView opaque="NO" contentMode="scaleToFill" axis="vertical" spacing="0" translatesAutoresizingMaskIntoConstraints="NO" id="dash-chrome">
                                <rect key="frame" x="0.0" y="0.0" width="393" height="88"/>
                                <subviews>
                                    <view contentMode="scaleToFill" translatesAutoresizingMaskIntoConstraints="NO" id="dash-header-panel">
                                        <rect key="frame" x="0.0" y="0.0" width="393" height="88"/>
                                        <subviews>
                                            <button opaque="NO" contentMode="scaleToFill" contentHorizontalAlignment="center" contentVerticalAlignment="center" lineBreakMode="middleTruncation" translatesAutoresizingMaskIntoConstraints="NO" id="dash-menu-btn">
                                                <state key="normal" image="line.3.horizontal" catalog="system"/>
                                                <connections>
                                                    <action selector="menuTapped:" destination="dash-vc" eventType="touchUpInside" id="dash-menu-act"/>
                                                </connections>
                                            </button>
                                            <label opaque="NO" userInteractionEnabled="NO" contentMode="left" text="Welcome back" translatesAutoresizingMaskIntoConstraints="NO" id="dash-welcome-lbl">
                                                <fontDescription key="fontDescription" type="boldSystem" pointSize="14"/>
                                            </label>
                                            <label opaque="NO" userInteractionEnabled="NO" contentMode="left" text="Here's what's happening today." translatesAutoresizingMaskIntoConstraints="NO" id="dash-sub-lbl">
                                                <fontDescription key="fontDescription" type="system" weight="light" pointSize="12"/>
                                                <color key="textColor" red="0.392" green="0.455" blue="0.545" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
                                            </label>
                                            <button opaque="NO" contentMode="scaleToFill" translatesAutoresizingMaskIntoConstraints="NO" id="dash-bell-btn">
                                                <state key="normal" image="bell" catalog="system"/>
                                                <connections>
                                                    <action selector="notificationsTapped:" destination="dash-vc" eventType="touchUpInside" id="dash-bell-act"/>
                                                </connections>
                                            </button>
                                            <label opaque="NO" userInteractionEnabled="NO" contentMode="center" text="A" textAlignment="center" translatesAutoresizingMaskIntoConstraints="NO" id="dash-avatar-lbl">
                                                <color key="backgroundColor" red="0.929" green="0.914" blue="0.996" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
                                                <fontDescription key="fontDescription" type="boldSystem" pointSize="14"/>
                                                <color key="textColor" red="0.486" green="0.227" blue="0.929" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
                                            </label>
                                            <view contentMode="scaleToFill" translatesAutoresizingMaskIntoConstraints="NO" id="dash-header-div">
                                                <color key="backgroundColor" red="0.886" green="0.910" blue="0.941" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
                                                <constraints>
                                                    <constraint firstAttribute="height" constant="1" id="dhd-h"/>
                                                </constraints>
                                            </view>
                                        </subviews>
                                        <color key="backgroundColor" white="1" alpha="1" colorSpace="custom" customColorSpace="genericGamma22GrayColorSpace"/>
                                        <constraints>
                                            <constraint firstItem="dash-menu-btn" firstAttribute="leading" secondItem="dash-header-panel" secondAttribute="leading" constant="12" id="dh1"/>
                                            <constraint firstItem="dash-menu-btn" firstAttribute="top" secondItem="dash-header-panel" secondAttribute="top" constant="12" id="dh2"/>
                                            <constraint firstItem="dash-menu-btn" firstAttribute="width" constant="40" id="dh3"/>
                                            <constraint firstItem="dash-menu-btn" firstAttribute="height" constant="40" id="dh4"/>
                                            <constraint firstItem="dash-welcome-lbl" firstAttribute="leading" secondItem="dash-menu-btn" secondAttribute="trailing" constant="8" id="dh5"/>
                                            <constraint firstItem="dash-welcome-lbl" firstAttribute="top" secondItem="dash-menu-btn" secondAttribute="top" id="dh6"/>
                                            <constraint firstItem="dash-sub-lbl" firstAttribute="leading" secondItem="dash-welcome-lbl" secondAttribute="leading" id="dh7"/>
                                            <constraint firstItem="dash-sub-lbl" firstAttribute="top" secondItem="dash-welcome-lbl" secondAttribute="bottom" constant="2" id="dh8"/>
                                            <constraint firstItem="dash-avatar-lbl" firstAttribute="trailing" secondItem="dash-header-panel" secondAttribute="trailing" constant="-12" id="dh9"/>
                                            <constraint firstItem="dash-avatar-lbl" firstAttribute="centerY" secondItem="dash-menu-btn" secondAttribute="centerY" id="dh10"/>
                                            <constraint firstItem="dash-avatar-lbl" firstAttribute="width" constant="36" id="dh11"/>
                                            <constraint firstItem="dash-avatar-lbl" firstAttribute="height" constant="36" id="dh12"/>
                                            <constraint firstItem="dash-bell-btn" firstAttribute="trailing" secondItem="dash-avatar-lbl" secondAttribute="leading" constant="-8" id="dh13"/>
                                            <constraint firstItem="dash-bell-btn" firstAttribute="centerY" secondItem="dash-menu-btn" secondAttribute="centerY" id="dh14"/>
                                            <constraint firstItem="dash-bell-btn" firstAttribute="width" constant="40" id="dh15"/>
                                            <constraint firstItem="dash-bell-btn" firstAttribute="height" constant="40" id="dh16"/>
                                            <constraint firstItem="dash-header-div" firstAttribute="leading" secondItem="dash-header-panel" secondAttribute="leading" id="dh17"/>
                                            <constraint firstItem="dash-header-div" firstAttribute="trailing" secondItem="dash-header-panel" secondAttribute="trailing" id="dh18"/>
                                            <constraint firstItem="dash-header-div" firstAttribute="bottom" secondItem="dash-header-panel" secondAttribute="bottom" id="dh19"/>
                                            <constraint firstItem="dash-header-div" firstAttribute="top" secondItem="dash-menu-btn" secondAttribute="bottom" constant="14" id="dh20"/>
                                        </constraints>
                                    </view>
                                </subviews>
                            </stackView>
                            <scrollView clipsSubviews="YES" multipleTouchEnabled="YES" contentMode="scaleToFill" translatesAutoresizingMaskIntoConstraints="NO" id="dash-scroll">
                                <rect key="frame" x="0.0" y="88" width="393" height="681"/>
                                <subviews>
                                    <stackView opaque="NO" contentMode="scaleToFill" axis="vertical" spacing="12" translatesAutoresizingMaskIntoConstraints="NO" id="dash-stack">
                                        <rect key="frame" x="16" y="16" width="361" height="200"/>
                                    </stackView>
                                </subviews>
                                <constraints>
                                    <constraint firstItem="dash-stack" firstAttribute="top" secondItem="dash-scroll" secondAttribute="top" constant="16" id="ds1"/>
                                    <constraint firstItem="dash-stack" firstAttribute="leading" secondItem="dash-scroll" secondAttribute="leading" constant="16" id="ds2"/>
                                    <constraint firstItem="dash-stack" firstAttribute="trailing" secondItem="dash-scroll" secondAttribute="trailing" constant="-16" id="ds3"/>
                                    <constraint firstItem="dash-stack" firstAttribute="bottom" secondItem="dash-scroll" secondAttribute="bottom" constant="-24" id="ds4"/>
                                    <constraint firstItem="dash-stack" firstAttribute="width" secondItem="dash-scroll" secondAttribute="width" constant="-32" id="ds5"/>
                                </constraints>
                            </scrollView>
                        </subviews>
                        <viewLayoutGuide key="safeArea" id="dash-safe"/>
                        <color key="backgroundColor" red="0.945" green="0.961" blue="0.976" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
                        <constraints>
                            <constraint firstItem="dash-chrome" firstAttribute="top" secondItem="dash-safe" secondAttribute="top" id="dv1"/>
                            <constraint firstItem="dash-chrome" firstAttribute="leading" secondItem="dash-view" secondAttribute="leading" id="dv2"/>
                            <constraint firstItem="dash-chrome" firstAttribute="trailing" secondItem="dash-view" secondAttribute="trailing" id="dv3"/>
                            <constraint firstItem="dash-scroll" firstAttribute="top" secondItem="dash-chrome" secondAttribute="bottom" id="dv4"/>
                            <constraint firstItem="dash-scroll" firstAttribute="leading" secondItem="dash-view" secondAttribute="leading" id="dv5"/>
                            <constraint firstItem="dash-scroll" firstAttribute="trailing" secondItem="dash-view" secondAttribute="trailing" id="dv6"/>
                            <constraint firstItem="dash-scroll" firstAttribute="bottom" secondItem="dash-safe" secondAttribute="bottom" id="dv7"/>
                        </constraints>
                    </view>
                    <connections>
                        <outlet property="avatarLabel" destination="dash-avatar-lbl" id="do-av"/>
                        <outlet property="chromeStackView" destination="dash-chrome" id="do1"/>
                        <outlet property="contentStackView" destination="dash-stack" id="do-stack"/>
                        <outlet property="contentView" destination="dash-scroll" id="do2"/>
                        <outlet property="dashboardSubtitleLabel" destination="dash-sub-lbl" id="do-sub"/>
                        <outlet property="menuButton" destination="dash-menu-btn" id="do-menu"/>
                        <outlet property="notificationsButton" destination="dash-bell-btn" id="do-bell"/>
                        <outlet property="welcomeLabel" destination="dash-welcome-lbl" id="do-wel"/>
                    </connections>
                </viewController>
                <placeholder placeholderIdentifier="IBFirstResponder" id="dash-fr" userLabel="First Responder" sceneMemberID="firstResponder"/>
            </objects>
            <point key="canvasLocation" x="700" y="-800"/>
        </scene>
        <!-- Orders Nav + VC (abbreviated - same chrome/content pattern) -->
        <scene sceneID="orders-nav-scene">
            <objects>
