<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Apple Push Notification environment. Xcode/Transporter promote this to
	     "production" automatically for App Store / TestFlight builds. Requires the
	     "Push Notifications" capability on the App ID + a matching provisioning profile. -->
	<key>aps-environment</key>
	<string>development</string>
</dict>
</plist>
