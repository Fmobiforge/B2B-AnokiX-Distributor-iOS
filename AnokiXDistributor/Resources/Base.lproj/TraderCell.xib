                    </view>
                </subviews>
                <constraints>
                    <constraint firstItem="card" firstAttribute="leading" secondItem="cv" secondAttribute="leading" id="c-l"/>
                    <constraint firstItem="card" firstAttribute="top" secondItem="cv" secondAttribute="top" id="c-t"/>
                    <constraint firstAttribute="trailing" secondItem="card" secondAttribute="trailing" id="c-tr"/>
                    <constraint firstAttribute="bottom" secondItem="card" secondAttribute="bottom" id="c-b"/>
                </constraints>
            </view>
            <connections>
                <outlet property="avatarLabel" destination="avatar" id="o-av"/>
                <outlet property="badgeLabel" destination="badge" id="o-bg"/>
                <outlet property="cardView" destination="card" id="o-card"/>
                <outlet property="locationLabel" destination="location" id="o-loc"/>
                <outlet property="nameLabel" destination="name" id="o-name"/>
                <outlet property="phoneLabel" destination="phone" id="o-phone"/>
