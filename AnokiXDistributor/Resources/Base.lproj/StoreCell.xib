                                </subviews>
                            </stackView>
                        </subviews>
                        <constraints>
                            <constraint firstItem="content" firstAttribute="leading" secondItem="card" secondAttribute="leading" constant="14" id="r-l"/>
                            <constraint firstItem="content" firstAttribute="top" secondItem="card" secondAttribute="top" constant="14" id="r-t"/>
                            <constraint firstAttribute="trailing" secondItem="content" secondAttribute="trailing" constant="14" id="r-tr"/>
