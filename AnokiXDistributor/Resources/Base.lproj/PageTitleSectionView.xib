<?xml version="1.0" encoding="UTF-8"?>
<document type="com.apple.InterfaceBuilder3.CocoaTouch.XIB" version="3.0" toolsVersion="22155" targetRuntime="iOS.CocoaTouch" propertyAccessControl="none" useAutolayout="YES" useTraitCollections="YES" useSafeAreas="YES" colorMatched="YES">
    <device id="retina6_12" orientation="portrait" appearance="light"/>
    <dependencies>
        <plugIn identifier="com.apple.InterfaceBuilder.IBCocoaTouchPlugin" version="22131"/>
        <capability name="documents saved in the Xcode 8 format" minToolsVersion="8.0"/>
    </dependencies>
    <objects>
        <placeholder placeholderIdentifier="IBFilesOwner" id="-1" userLabel="File's Owner"/>
        <placeholder placeholderIdentifier="IBFirstResponder" id="-2" customClass="UIResponder"/>
        <view contentMode="scaleToFill" id="pt-root" customClass="PageTitleSectionView" customModule="AnokiXDistributor" customModuleProvider="target">
            <rect key="frame" x="0.0" y="0.0" width="393" height="56"/>
            <autoresizingMask key="autoresizingMask" widthSizable="YES" flexibleMaxY="YES"/>
            <subviews>
                <label opaque="NO" userInteractionEnabled="NO" contentMode="left" horizontalHuggingPriority="251" verticalHuggingPriority="251" text="Title" textAlignment="natural" lineBreakMode="tailTruncation" baselineAdjustment="alignBaselines" adjustsFontSizeToFit="NO" translatesAutoresizingMaskIntoConstraints="NO" id="pt-title">
                    <rect key="frame" x="16" y="12" width="361" height="19"/>
                    <fontDescription key="fontDescription" type="boldSystem" pointSize="16"/>
                </label>
                <label opaque="NO" userInteractionEnabled="NO" contentMode="left" horizontalHuggingPriority="251" verticalHuggingPriority="251" text="Subtitle" textAlignment="natural" lineBreakMode="tailTruncation" baselineAdjustment="alignBaselines" adjustsFontSizeToFit="NO" translatesAutoresizingMaskIntoConstraints="NO" id="pt-sub">
                    <rect key="frame" x="16" y="33" width="361" height="15"/>
                    <fontDescription key="fontDescription" type="system" weight="light" pointSize="12"/>
                    <color key="textColor" red="0.361" green="0.420" blue="0.478" alpha="1" colorSpace="custom" customColorSpace="sRGB"/>
                </label>
            </subviews>
            <color key="backgroundColor" white="1" alpha="1" colorSpace="custom" customColorSpace="genericGamma22GrayColorSpace"/>
            <constraints>
                <constraint firstItem="pt-title" firstAttribute="top" secondItem="pt-root" secondAttribute="top" constant="12" id="c1"/>
                <constraint firstItem="pt-title" firstAttribute="leading" secondItem="pt-root" secondAttribute="leading" constant="16" id="c2"/>
                <constraint firstItem="pt-title" firstAttribute="trailing" secondItem="pt-root" secondAttribute="trailing" constant="-16" id="c3"/>
                <constraint firstItem="pt-sub" firstAttribute="top" secondItem="pt-title" secondAttribute="bottom" constant="2" id="c4"/>
                <constraint firstItem="pt-sub" firstAttribute="leading" secondItem="pt-title" secondAttribute="leading" id="c5"/>
                <constraint firstItem="pt-sub" firstAttribute="trailing" secondItem="pt-title" secondAttribute="trailing" id="c6"/>
                <constraint firstItem="pt-sub" firstAttribute="bottom" secondItem="pt-root" secondAttribute="bottom" constant="-12" id="c7"/>
            </constraints>
            <connections>
                <outlet property="subtitleLabel" destination="pt-sub" id="o1"/>
                <outlet property="titleLabel" destination="pt-title" id="o2"/>
            </connections>
        </view>
    </objects>
</document>
